# Variables de la API (docs/plan/01 §Variables de entorno). Copiar a `.env` en local; NUNCA commitear `.env`.
# `tests/test_config.py` exige que este archivo tenga exactamente las claves de `src/config.py::Settings`.

# --- Base de datos ---
# Neon con pooler (-pooler) en Railway; Postgres local en desarrollo.
DATABASE_URL=postgresql+psycopg://dev:dev@127.0.0.1:5432/panaderia_dev
# Neon directo (sin -pooler), solo para Alembic. Vacía en local.
DATABASE_URL_DIRECT=
# Solo pruebas: base propia del agente (docs/plan/05 §1).
TEST_DATABASE_URL=postgresql+psycopg://dev:dev@127.0.0.1:5432/panaderia_test_fnd

# --- Seguridad ---
# Aleatorio y largo; el mismo valor va en el servicio web (${{api.JWT_SECRET}} en Railway).
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=1800
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_GRACE_SECONDS=60

# --- Entorno ---
# development | staging | production
ENVIRONMENT=development
# Dominio(s) de la web, separados por coma.
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
# true en Railway; false en pruebas, E2E y CI.
SCHEDULER_ENABLED=false

# --- Archivos (E4) ---
# s3 (Railway Bucket) o local.
STORAGE_BACKEND=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Notificaciones (E3–E4): vacías = solo log ---
FCM_CREDENTIALS_JSON=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Tasa BCV ---
BCV_SOURCE_URL=https://ve.dolarapi.com/v1/dolares/oficial

# --- Arranque (scripts/bootstrap.py) ---
# Crea el primer ADMIN si no existe ninguno (con cambio de contraseña obligatorio).
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=
# 1 = datos de demostración (solo staging). Exige SEED_PASSWORD.
SEED_DEMO=0
SEED_PASSWORD=
