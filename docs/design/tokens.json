{
  "$description": "Fuente de los tokens del panel (E1). web/src/app/globals.css los declara tal cual; la prueba web/src/app/tokens.test.ts verifica que coincidan. Android los tomará en su etapa.",
  "$version": "1.0.0",
  "direction": "Salida estándar de apps de delivery (Uber y Rappi como vara): blanco y gris claro, tinta negra, botón primario negro, un naranja de horno solo para marca, foco y selección; rojo Debe, verde A favor.",
  "color": {
    "light": {
      "canvas": "#FFFFFF",
      "canvas-subtle": "#F4F4F2",
      "surface": "#FFFFFF",
      "surface-raised": "#FFFFFF",
      "surface-sunken": "#EDEDEA",
      "line": "#E6E6E3",
      "line-strong": "#CFCFCB",
      "ink": "#111111",
      "ink-muted": "#5C5C58",
      "ink-faint": "#6B6B67",
      "primary": "#111111",
      "primary-hover": "#2E2E2C",
      "on-primary": "#FFFFFF",
      "brand": "#E35A0F",
      "brand-ink": "#B8460A",
      "brand-subtle": "#FFF0E6",
      "on-brand": "#FFFFFF",
      "debt": "#C4271B",
      "debt-subtle": "#FDEDEB",
      "favor": "#0A7A3F",
      "favor-subtle": "#E6F4EC",
      "warn": "#8F5B00",
      "warn-subtle": "#FFF3D9",
      "focus": "#E35A0F",
      "scrim": "rgba(17, 17, 17, 0.48)"
    },
    "dark": {
      "canvas": "#0F0F0F",
      "canvas-subtle": "#1B1B1B",
      "surface": "#171717",
      "surface-raised": "#202020",
      "surface-sunken": "#262626",
      "line": "#2C2C2C",
      "line-strong": "#3D3D3D",
      "ink": "#F4F4F2",
      "ink-muted": "#A9A9A4",
      "ink-faint": "#8F8F8A",
      "primary": "#F4F4F2",
      "primary-hover": "#FFFFFF",
      "on-primary": "#111111",
      "brand": "#FF7A33",
      "brand-ink": "#FF9A5C",
      "brand-subtle": "#3A2213",
      "on-brand": "#111111",
      "debt": "#FF7A6E",
      "debt-subtle": "#3B1A17",
      "favor": "#5CCF8C",
      "favor-subtle": "#13301F",
      "warn": "#F2C14E",
      "warn-subtle": "#362A10",
      "focus": "#FF7A33",
      "scrim": "rgba(0, 0, 0, 0.64)"
    },
    "contrast": {
      "$description": "WCAG medido sobre canvas (y canvas-subtle). brand solo se usa como marca grande, anillo de foco e indicador de selección (no es texto pequeño).",
      "light": { "ink-muted": "6.72", "ink-faint/canvas-subtle": "4.86", "brand-ink": "5.36", "debt": "5.75", "favor": "5.43", "warn/warn-subtle": "5.21", "brand (no texto)": "3.66" },
      "dark": { "ink-muted": "8.12", "ink-faint/canvas-subtle": "5.30", "brand-ink": "9.15", "debt": "7.54", "favor/favor-subtle": "7.32", "warn/warn-subtle": "8.37" }
    }
  },
  "font": {
    "family": "\"Archivo Variable\", \"Archivo\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
    "source": "@fontsource-variable/archivo (wdth + wght, autoalojada)",
    "features": "tnum en todo número de dinero, fecha y cantidad",
    "scale": {
      "xs": { "size": "0.75rem", "line": "1rem" },
      "sm": { "size": "0.875rem", "line": "1.25rem" },
      "base": { "size": "1rem", "line": "1.5rem" },
      "lg": { "size": "1.125rem", "line": "1.5rem" },
      "xl": { "size": "1.25rem", "line": "1.75rem" },
      "2xl": { "size": "1.5rem", "line": "1.875rem" },
      "3xl": { "size": "2rem", "line": "2.25rem" },
      "amount": { "size": "3rem", "line": "3rem" }
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "heavy": 800 },
    "stretch": { "display": "92%", "body": "100%" },
    "tracking": { "display": "-0.025em", "amount": "-0.03em", "body": "0" }
  },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px" },
  "radius": { "sm": "8px", "md": "12px", "lg": "16px", "sheet": "20px", "pill": "9999px" },
  "size": { "touch": "48px", "control": "48px", "control-lg": "56px", "sidebar": "248px", "topbar": "64px" },
  "elevation": {
    "$description": "Una sola declaración por superficie: borde o sombra, nunca ambos.",
    "flat": "none",
    "popover": "0 8px 24px rgba(17, 17, 17, 0.12)",
    "sheet": "0 -8px 32px rgba(17, 17, 17, 0.16)",
    "bar": "0 -1px 0 var(--color-line)"
  },
  "motion": {
    "fast": "150ms",
    "base": "200ms",
    "sheet": "260ms",
    "amount": "420ms",
    "ease-out": "cubic-bezier(0.2, 0.8, 0.2, 1)",
    "ease-in": "cubic-bezier(0.4, 0, 1, 1)",
    "reduced": "Con prefers-reduced-motion todo cambio es instantáneo, salvo el fundido de 1 ms."
  }
}
