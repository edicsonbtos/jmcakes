# URL base de la API (se incrusta en el build). En local contra el mock:
#   MOCK_PORT=4010 npm run mock   ->   http://127.0.0.1:4010/api/v1
NEXT_PUBLIC_API_URL=http://127.0.0.1:4010/api/v1
# Mismo secreto que la API (en Railway: ${{api.JWT_SECRET}}).
# Solo en modo mock: dev-mock-secret-no-usar-en-prod
JWT_SECRET=dev-mock-secret-no-usar-en-prod
# Puertos del agente DSN (docs/plan/05 §1)
WEB_PORT=3000
MOCK_PORT=4010
# Habilita /design en un build de producción (solo CI de capturas). En Railway: 0.
ENABLE_DESIGN_PAGE=0
